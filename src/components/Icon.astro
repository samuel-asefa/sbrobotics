---
// Small line icons used across the site. Decorative by default.
interface Props {
  name: 'arrow-right' | 'arrow-up-right' | 'arrow-down' | 'arrow-left' | 'mail' | 'pin' | 'close' | 'pause' | 'play';
  size?: number;
  class?: string;
}
const { name, size = 18, class: cls } = Astro.props;
---
<svg
  class={cls}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.75"
  stroke-linecap="square"
  aria-hidden="true"
  focusable="false"
>
  {name === 'arrow-right' && <path d="M4 12h15M13 6l6 6-6 6" />}
  {name === 'arrow-left' && <path d="M20 12H5M11 6l-6 6 6 6" />}
  {name === 'arrow-up-right' && <path d="M7 17 17 7M8 7h9v9" />}
  {name === 'arrow-down' && <path d="M12 4v15M6 13l6 6 6-6" />}
  {name === 'mail' && <><path d="M3 6h18v12H3z" /><path d="m3 7 9 6 9-6" /></>}
  {name === 'pin' && <><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21z" /><circle cx="12" cy="9.5" r="2.5" /></>}
  {name === 'close' && <path d="M5 5l14 14M19 5 5 19" />}
  {name === 'pause' && <path d="M8 5v14M16 5v14" />}
  {name === 'play' && <path d="M7 5l12 7-12 7z" />}
</svg>
