---
// Simple original line icons for each VEX award type.
import type { AwardKind } from '../lib/data';
interface Props { kind: AwardKind; size?: number; class?: string }
const { kind, size = 28, class: cls } = Astro.props;
---
<svg class={cls} width={size} height={size} viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {kind === 'excellence' && (
    <>
      <path d="M16 3 27 9.5v13L16 29 5 22.5v-13z" />
      <path d="m16 10 1.9 3.9 4.3.6-3.1 3 .7 4.3-3.8-2-3.8 2 .7-4.3-3.1-3 4.3-.6z" />
    </>
  )}
  {kind === 'champions' && (
    <>
      <path d="M10 5h12v6a6 6 0 0 1-12 0z" />
      <path d="M10 7H6v2a4 4 0 0 0 4 4M22 7h4v2a4 4 0 0 1-4 4M16 17v5M11 27h10M12.5 22h7l1 5h-9z" />
    </>
  )}
  {kind === 'finalists' && (
    <>
      <circle cx="16" cy="20" r="7" />
      <path d="M11 4h4l3 9M21 4h-4M13.5 18.5 16 17v6" />
    </>
  )}
  {kind === 'skills' && (
    <>
      <circle cx="16" cy="18" r="10" />
      <path d="M13 4h6M16 4v4M16 18l5-5M26 8l-2 2" />
    </>
  )}
  {kind === 'design' && (
    <>
      <path d="M16 4v4M16 8l-8 20M16 8l8 20M10.5 21h11" />
      <circle cx="16" cy="8" r="2" />
    </>
  )}
  {kind === 'innovate' && (
    <>
      <path d="M11.5 20a8 8 0 1 1 9 0V23h-9z" />
      <path d="M12 27h8M16 13v5M14 15l2-2 2 2" />
    </>
  )}
  {kind === 'think' && (
    <>
      <path d="m11 10-6 6 6 6M21 10l6 6-6 6M18.5 7l-5 18" />
    </>
  )}
  {kind === 'amaze' && <path d="M18 3 7 18h8l-2 11 12-16h-8z" />}
  {kind === 'judges' && (
    <>
      <path d="M3 16s5-8 13-8 13 8 13 8-5 8-13 8S3 16 3 16z" />
      <circle cx="16" cy="16" r="3.5" />
    </>
  )}
  {kind === 'sportsmanship' && <path d="M16 27S5 20.5 5 12.5A5.5 5.5 0 0 1 16 10a5.5 5.5 0 0 1 11 2.5C27 20.5 16 27 16 27z" />}
  {kind === 'create' && (
    <>
      <path d="m20 5 7 7-15 15H5v-7z" />
      <path d="m17 8 7 7" />
    </>
  )}
  {kind === 'other' && (
    <>
      <circle cx="16" cy="12" r="7" />
      <path d="m11 17-3 11 8-4 8 4-3-11" />
    </>
  )}
</svg>
