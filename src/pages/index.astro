---
import { Picture } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import Marquee from '../components/Marquee.astro';
import SectionHead from '../components/SectionHead.astro';
import Stat from '../components/Stat.astro';
import TeamId from '../components/TeamId.astro';
import SeasonTimeline from '../components/SeasonTimeline.astro';
import ClosingCTA from '../components/ClosingCTA.astro';
import statesPhoto from '../assets/photos/2025-nj-states-750b.png';
import worldsPhoto from '../assets/photos/2025-worlds-dallas.jpeg';
import girlPoweredPhoto from '../assets/photos/girl-powered-workshop.png';
import { site } from '../data/site';
import {
  allAwards,
  allEvents,
  awardSeasons,
  awardsForTeam,
  countByKind,
  latestRosterSeason,
  memberCount,
  pad2,
  seasonLabel,
  isCaptainRole,
  teamName,
  teamsForSeason,
} from '../lib/data';

// Results (all computed from src/data)
const awards = allAwards();
const teamAwards = awards.length;
const excellence = countByKind(awards).get('excellence') ?? 0;
const eventsWithAwards = allEvents().length;
const oldest = awardSeasons[awardSeasons.length - 1];
const newest = awardSeasons[0];
const awardScope = `${seasonLabel(oldest)} to ${seasonLabel(newest)} · selected events`;

// Teams (latest season with a published roster)
const rosterSeason = latestRosterSeason;
const teams = teamsForSeason(rosterSeason).map((t) => ({
  ...t,
  name: teamName(rosterSeason, t.id),
  captains: t.members.filter((m) => isCaptainRole(m.role)).map((m) => m.name),
  awardCount: awardsForTeam(t.id).length,
}));
const students = memberCount(rosterSeason);

// The season story shown on the homepage: the most recent season with a full set of records.
const storySeason = '2025';

const disciplines = [
  { title: 'Design', text: 'Sketch ideas, model mechanisms in CAD, and decide what is worth building before anything gets cut.' },
  { title: 'Build', text: 'Assemble the robot, test it on the field, and rebuild mechanisms as the game strategy changes.' },
  { title: 'Program', text: 'Write the autonomous routines and driver controls, then tune them until they run reliably in matches.' },
  { title: 'Compete', text: 'Drive qualification and elimination matches with alliance partners, and run the robot skills challenge.' },
  { title: 'Document', text: 'Record every decision in an engineering notebook and explain the team’s process to judges.' },
];
---
<Layout title={site.name}>
  <!-- ============ HERO ============ -->
  <section class="hero" aria-labelledby="hero-title">
    <div class="hero__media">
      <div class="hero__img-wrap" data-parallax="0.08">
        <Picture
          src={statesPhoto}
          formats={['avif', 'webp']}
          fallbackFormat="jpg"
          widths={[640, 960, 1280, 1454]}
          sizes="100vw"
          alt="Members of team 750B in matching black 750 sweatshirts holding their robot and two trophies at the 2025 New Jersey State Championship at NJIT."
          loading="eager"
          fetchpriority="high"
          class="hero__img"
        />
      </div>
      <div class="hero__shade" aria-hidden="true"></div>
    </div>

    <div class="wrap hero__inner">
      <div class="hero__top">
        <p class="label hero-a" style="--h:0">
          {site.school} <span class="gold">//</span> Monmouth Junction, NJ
        </p>
        <p class="label hero-a hero__codes" style="--h:1">VEX V5RC · 750B · C · E · R · S · W</p>
      </div>

      <h1 id="hero-title" class="hero__title display display--italic">
        <span class="hero__line"><span class="hero__word outline" style="--h:1">South</span> <span class="hero__word outline" style="--h:2">Brunswick</span></span>
        <span class="hero__line"><span class="hero__word" style="--h:3">Robotics</span><span class="hero__tag hero-a" style="--h:5" aria-hidden="true">750</span></span>
      </h1>

      <div class="hero__foot">
        <p class="hero__lede hero-a" style="--h:4">
          The VEX V5 robotics program at South Brunswick High School. Six student teams design, build, program, and drive their own robots, then take them to competitions across New Jersey and beyond.
        </p>
        <div class="hero__actions hero-a" style="--h:5">
          <a class="btn btn--gold" href="/roster">
            Explore the teams
            <Icon name="arrow-right" size={16} class="btn__arrow" />
          </a>
          <a class="btn" href="/contact">Get involved</a>
        </div>
        <a class="hero__explore hero-a" style="--h:6" href="#program" aria-label="Skip to the program overview">
          <svg viewBox="0 0 120 120" class="hero__ring" data-loop aria-hidden="true">
            <defs><path id="ring" d="M60 60m-46 0a46 46 0 1 1 92 0a46 46 0 1 1-92 0" /></defs>
            <text><textPath href="#ring" textLength="286" lengthAdjust="spacing">Explore · the program · Explore · the program ·</textPath></text>
          </svg>
          <Icon name="arrow-down" size={22} class="hero__arrow" />
        </a>
      </div>

      <p class="hero__caption caption hero-a" style="--h:7">750B · 2025 NJ State Championship · NJIT, Newark</p>
    </div>
  </section>

  <Marquee items={['CAD', 'Mechanical design', 'Prototyping', 'Programming', 'Autonomous routines', 'Driver practice', 'Match strategy', 'Engineering notebook', 'Judged interviews']} />

  <!-- ============ 01 PROGRAM ============ -->
  <section class="section program" id="program" aria-labelledby="program-title">
    <div class="program__ghost display display--italic outline" aria-hidden="true" data-parallax="0.1">750</div>
    <div class="wrap">
      <div class="program__grid">
        <div>
          <SectionHead num="01" label="The program" id="program-title" title={`Built by students, <span class="gold">from first sketch to final match.</span>`} />
        </div>
        <div class="program__copy">
          <p class="lead" data-reveal>
            Every VEX season brings a new game. Our teams start from scratch and work through the full engineering cycle, from first idea to the last tournament of the year.
          </p>
          <p class="mute" data-reveal style="--d:1">
            Robots in the VEX V5 Robotics Competition must be designed, built, and programmed by students. That is the whole point: members learn by doing the work, making mistakes on the practice field, and fixing them before the next event.
          </p>
          <a class="link-arrow" href="/about" data-reveal style="--d:2">
            How the program works
            <Icon name="arrow-right" size={16} />
          </a>
        </div>
      </div>

      <ol class="disciplines">
        {disciplines.map((d, i) => (
          <li class="discipline" data-reveal style={`--d:${i}`}>
            <span class="discipline__num label label--gold">{pad2(i + 1)}</span>
            <h3 class="discipline__title display display--italic">{d.title}</h3>
            <p>{d.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- ============ 02 RESULTS ============ -->
  <section class="section results" id="results" aria-labelledby="results-title">
    <div class="wrap">
      <div class="results__head">
        <SectionHead num="02" label="On the record" id="results-title" title={`Results, <span class="gold">in context.</span>`} />
        <p class="results__note mute" data-reveal style="--d:1">
          These numbers are calculated from the records published on this site: selected events from {seasonLabel(oldest)} through {seasonLabel(newest)}, not a complete lifetime history. One team award means one team receiving one award at one event.
        </p>
      </div>
      <div class="results__grid">
        <Stat value={teamAwards} label="Team awards" scope={awardScope} d={0} />
        <Stat value={eventsWithAwards} label="Events with an SB award" scope={awardScope} d={1} />
        <Stat value={excellence} label="Excellence Awards" scope={`The top award at a VEX event · ${seasonLabel(oldest)} to ${seasonLabel(newest)}`} d={2} />
        <Stat value={1} label="World Championship team" scope="750B · Dallas, TX · May 2025" d={3} />
      </div>
      <a class="link-arrow results__more" href="/achievements" data-reveal>
        Open the trophy case
        <Icon name="arrow-right" size={16} />
      </a>
    </div>
  </section>

  <!-- ============ 03 TEAMS ============ -->
  <section class="section teams" id="teams" aria-labelledby="teams-title">
    <div class="wrap">
      <div class="teams__head">
        <SectionHead num="03" label={`Teams · ${seasonLabel(rosterSeason)} roster`} id="teams-title" title={`Six teams. <span class="gold">One crew.</span>`} />
        <p class="mute teams__intro" data-reveal style="--d:1">
          {students} students are listed across six teams on the {seasonLabel(rosterSeason)} roster. Each team builds and competes with its own robot; together they make up South Brunswick Robotics.
        </p>
      </div>

      <ul class="team-grid">
        {teams.map((t, i) => (
          <li data-reveal style={`--d:${i % 3}`}>
            <a class="team-tile" href={`/roster?season=${rosterSeason}#team-${rosterSeason}-${t.id}`}>
              <span class="team-tile__bg display display--italic outline" aria-hidden="true">{t.letter}</span>
              <span class="team-tile__top">
                <TeamId id={t.id} class="team-tile__id" />
                {t.name && <span class="label label--sm">“{t.name}”</span>}
              </span>
              <span class="team-tile__meta">
                <span><span class="label label--sm">Members</span><strong>{pad2(t.members.length)}</strong></span>
                <span><span class="label label--sm">Team awards</span><strong>{pad2(t.awardCount)}</strong></span>
              </span>
              <span class="team-tile__captain">
                <span class="label label--sm">{t.captains.length > 1 ? 'Captains' : 'Captain'}</span>
                <span>{t.captains.join(', ') || '—'}</span>
              </span>
              <span class="team-tile__go" aria-hidden="true"><Icon name="arrow-up-right" size={20} /></span>
            </a>
          </li>
        ))}
      </ul>
      <p class="teams__foot" data-reveal>
        <span class="label label--sm">Team names as listed on VEX Events. Award counts include every season on record.</span>
        <a class="link-arrow" href="/roster">Full roster and past seasons <Icon name="arrow-right" size={16} /></a>
      </p>
    </div>
  </section>

  <!-- ============ 04 SEASON ============ -->
  <section class="section season" id="season" aria-labelledby="season-title">
    <div class="wrap">
      <div class="season__head">
        <SectionHead num="04" label={`Season story · ${seasonLabel(storySeason)} High Stakes`} id="season-title" title={`New Jersey <span class="gold">to Dallas.</span>`} />
        <p class="mute season__intro" data-reveal style="--d:1">
          The 2024–25 season through our recorded awards, event by event, ending at the World Championship. Each card links to the official results.
        </p>
      </div>
      <SeasonTimeline season={storySeason} />
      <div class="season__foot">
        <a class="link-arrow" href="/achievements">Every season in the awards archive <Icon name="arrow-right" size={16} /></a>
      </div>
    </div>
  </section>

  <!-- ============ 05 FEATURE ============ -->
  <section class="section feature" id="worlds-2025" aria-labelledby="feature-title">
    <div class="wrap feature__grid">
      <figure class="feature__media">
        <div class="frame feature__frame" data-reveal="mask">
          <Picture
            src={worldsPhoto}
            formats={['avif', 'webp']}
          fallbackFormat="jpg"
            widths={[480, 800]}
            sizes="(min-width: 1024px) 40vw, 92vw"
            alt="A group of South Brunswick Robotics members standing outside the 2025 VEX Robotics World Championship beneath a banner that reads ‘Welcome to the largest robotics competition in the world’."
            class="feature__img"
          />
        </div>
        <figcaption class="caption">SB Robotics members at the World Championship · Dallas, TX · May 2025</figcaption>
      </figure>

      <div class="feature__copy">
        <p class="feature__stamp" data-reveal="fade"><span class="chip chip--gold">Archive</span><span class="label">Spring 2025 · 2024–25 season</span></p>
        <h2 id="feature-title" class="feature__title display display--italic" data-reveal>
          <span class="outline">From Newark</span>
          <span>to Dallas</span>
        </h2>
        <div class="prose-sb" data-reveal style="--d:1">
          <p>
            On March 15, 2025, <strong>750B</strong> reached the final of the New Jersey State Championship at NJIT and won the <strong>Think Award</strong>, the judged award for programming. Both results qualified the team for the VEX Robotics World Championship.
          </p>
          <p>
            From May 6 to 8, 750B competed in the Math division of the high school V5RC event at the Kay Bailey Hutchison Convention Center in Dallas, one of 831 teams entered.
          </p>
        </div>
        <dl class="feature__facts" data-reveal style="--d:2">
          <div><dt class="label label--sm">Team</dt><dd><TeamId id="750B" /> Blitz</dd></div>
          <div><dt class="label label--sm">Qualified at</dt><dd>NJ States · Mar 15, 2025</dd></div>
          <div><dt class="label label--sm">Qualifying results</dt><dd>Tournament Finalists · Think Award</dd></div>
          <div><dt class="label label--sm">Worlds</dt><dd>May 6–8, 2025 · Math division</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- ============ 06 COMMUNITY ============ -->
  <section class="section community" id="community" aria-labelledby="community-title">
    <div class="wrap community__grid">
      <div class="community__copy">
        <SectionHead num="05" label="Community · Girl Powered" id="community-title" title={`Bringing the design process <span class="gold">to middle school.</span>`} />
        <p class="lead" data-reveal>
          Each year our members run a Girl Powered event for girls from South Brunswick middle schools, usually with around 30 to 50 students taking part.
        </p>
        <ol class="community__steps" data-reveal style="--d:1">
          <li><span class="label label--gold">01</span><p>Students are introduced to the engineering design process.</p></li>
          <li><span class="label label--gold">02</span><p>They create their own designs and add their own interpretations to them.</p></li>
          <li><span class="label label--gold">03</span><p>They build a plastic-bottle car, putting the process into practice.</p></li>
        </ol>
        <a class="link-arrow" href="/outreach" data-reveal style="--d:2">More about our outreach <Icon name="arrow-right" size={16} /></a>
      </div>
      <figure class="community__media">
        <div class="frame community__frame" data-reveal="mask">
          <Picture
            src={girlPoweredPhoto}
            formats={['avif', 'webp']}
          fallbackFormat="jpg"
            widths={[480, 736]}
            sizes="(min-width: 1024px) 50vw, 92vw"
            alt="Middle school students working on designs at tables in a school library during a Girl Powered workshop, with slides projected at the front of the room."
            class="community__img"
          />
        </div>
        <figcaption class="caption">Girl Powered workshop at a South Brunswick middle school</figcaption>
      </figure>
    </div>
  </section>

  <ClosingCTA />
</Layout>

<style>
  /* ---------------- Hero ---------------- */
  .hero {
    position: relative;
    min-height: max(640px, 100svh);
    display: flex;
    isolation: isolate;
    overflow: hidden;
  }
  .hero__media { position: absolute; inset: 0; z-index: -1; overflow: hidden; background: var(--color-coal); }
  .hero__img-wrap { position: absolute; inset: 0; will-change: transform; }
  .hero__img-wrap :global(picture),
  .hero__img-wrap :global(img) { display: block; width: 100%; height: 100%; }
  .hero__img-wrap :global(img) {
    object-fit: cover;
    object-position: 50% 14%;
    filter: saturate(0.5) contrast(1.06) brightness(0.78);
  }
  .hero__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, var(--color-ink) 4%, rgb(10 10 11 / 0.82) 34%, rgb(10 10 11 / 0.15) 66%, rgb(10 10 11 / 0.55) 100%),
      linear-gradient(to right, rgb(10 10 11 / 0.55), transparent 60%);
  }
  .hero__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding-top: calc(var(--header-h) + 1.5rem);
    padding-bottom: clamp(2rem, 4vw, 3rem);
  }
  .hero__top {
    position: absolute;
    top: calc(var(--header-h) + 1.25rem);
    left: var(--gutter);
    right: var(--gutter);
    display: flex;
    justify-content: space-between;
    gap: 1rem;
  }
  .hero__codes { display: none; }
  @media (min-width: 900px) { .hero__codes { display: block; } }

  .hero__title {
    font-size: clamp(4.1rem, 12.2vw, 13.25rem);
    line-height: 0.84;
    margin-left: -0.04em;
  }
  .hero__line { display: block; overflow: hidden; padding: 0.02em 0.1em 0.06em 0.02em; margin-bottom: -0.06em; }
  .hero__word { display: inline-block; }
  .hero__tag {
    display: inline-block;
    margin-left: 0.18em;
    font-size: 0.28em;
    vertical-align: 1.95em;
    color: var(--color-ink);
    background: var(--color-gold);
    padding: 0.1em 0.22em 0.06em 0.16em;
    line-height: 1;
  }
  @media (max-width: 767px) {
    .hero__title { font-size: clamp(3.6rem, 19.5vw, 6.5rem); }
    .hero__line:first-child .hero__word { display: block; }
  }

  .hero__foot {
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    display: grid;
    gap: 1.5rem;
    align-items: end;
  }
  @media (min-width: 900px) {
    .hero__foot { grid-template-columns: minmax(0, 33rem) auto 1fr; gap: 2.5rem; }
  }
  .hero__lede { font-size: clamp(1.05rem, 1.35vw, 1.2rem); color: var(--color-paper); max-width: 36rem; line-height: 1.55; }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; }

  .hero__explore {
    display: none;
    position: relative;
    width: 116px;
    height: 116px;
    justify-self: end;
    border-radius: 50%;
    color: var(--color-paper);
  }
  @media (min-width: 900px) { .hero__explore { display: grid; place-items: center; } }
  .hero__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    font-family: var(--font-mono);
    font-size: 9.6px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    fill: var(--color-mute);
    animation: spin 22s linear infinite;
  }
  .hero__ring[data-offscreen="true"] { animation-play-state: paused; }
  .hero__explore :global(.hero__arrow) { transition: transform var(--dur) var(--ease-out-expo); color: var(--color-gold); }
  .hero__explore::before {
    content: "";
    position: absolute;
    inset: 26px;
    border-radius: 50%;
    border: 1px solid var(--color-line-strong);
    transition: background-color var(--dur-fast), border-color var(--dur-fast);
  }
  .hero__explore:hover::before, .hero__explore:focus-visible::before { background: var(--color-gold); border-color: var(--color-gold); }
  .hero__explore:hover :global(.hero__arrow), .hero__explore:focus-visible :global(.hero__arrow) { color: var(--color-ink); transform: translateY(3px); }
  .hero__explore:focus-visible { outline-offset: -8px; }
  @keyframes spin { to { transform: rotate(360deg); } }

  .hero__caption { margin-top: 1.5rem; justify-content: flex-end; }
  @media (max-width: 899px) { .hero__caption { justify-content: flex-start; } }

  @media (prefers-reduced-motion: no-preference) {
    .hero__word { animation: rise 1.1s var(--ease-out-expo) both; animation-delay: calc(150ms + var(--h) * 110ms); }
    .hero-a { animation: fade-up 1s var(--ease-out-expo) both; animation-delay: calc(250ms + var(--h) * 110ms); }
    .hero__img-wrap :global(img) { animation: settle 2.2s var(--ease-out-expo) both; }
  }
  @keyframes rise { from { transform: translateY(108%); } to { transform: none; } }
  @keyframes fade-up { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @keyframes settle { from { transform: scale(1.08); opacity: 0.4; } to { transform: none; opacity: 1; } }

  /* ---------------- Program ---------------- */
  .program { overflow: hidden; }
  .program__ghost {
    position: absolute;
    right: -0.05em;
    top: 0.2em;
    font-size: clamp(14rem, 34vw, 32rem);
    line-height: 0.8;
    opacity: 0.16;
    pointer-events: none;
    user-select: none;
  }
  .program__grid { display: grid; gap: 2.5rem; }
  @media (min-width: 1024px) {
    .program__grid { grid-template-columns: 7fr 5fr; gap: 4rem; align-items: end; }
  }
  .program__copy { display: grid; gap: 1.25rem; justify-items: start; max-width: 36rem; }
  .program__copy .lead { max-width: none; }

  .disciplines {
    list-style: none;
    margin: clamp(3.5rem, 7vw, 6rem) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr;
    border-top: 1px solid var(--color-line);
  }
  @media (min-width: 640px) { .disciplines { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .disciplines { grid-template-columns: repeat(5, 1fr); } }
  .discipline {
    position: relative;
    padding: 1.75rem 1.5rem 2rem 0;
    border-bottom: 1px solid var(--color-line);
  }
  @media (min-width: 1100px) {
    .discipline { border-bottom: 0; padding: 2rem 1.75rem 0 0; }
    .discipline + .discipline { padding-left: 1.75rem; border-left: 1px solid var(--color-line); }
  }
  .discipline__title { font-size: clamp(2.2rem, 3.4vw, 3rem); margin: 1rem 0 0.75rem; }
  .discipline p { color: var(--color-mute); font-size: 0.975rem; line-height: 1.6; }
  .discipline:hover .discipline__title { color: var(--color-gold); }
  .discipline__title { transition: color var(--dur-fast) ease; }

  /* ---------------- Results ---------------- */
  .results { background: var(--color-coal); border-block: 1px solid var(--color-line); }
  .results__head { display: grid; gap: 1.5rem; align-items: end; }
  @media (min-width: 1024px) { .results__head { grid-template-columns: 7fr 5fr; gap: 4rem; } }
  .results__note { font-size: 0.975rem; max-width: 40rem; }
  .results__grid {
    margin-top: clamp(3rem, 6vw, 5rem);
    display: grid;
    gap: 2.75rem 2rem;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
  @media (min-width: 1024px) { .results__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); } }
  @media (max-width: 639px) {
    .results__grid { gap: 2.25rem 1.25rem; }
    .results__grid :global(.stat__num) { font-size: 4.5rem; }
    .results__grid :global(.stat__label) { font-size: 1.1rem; }
  }
  .results__more { margin-top: 3rem; }

  /* ---------------- Teams ---------------- */
  .teams__head { display: grid; gap: 1.5rem; align-items: end; }
  @media (min-width: 1024px) { .teams__head { grid-template-columns: 7fr 5fr; gap: 4rem; } }
  .teams__intro { max-width: 34rem; }
  .team-grid {
    list-style: none;
    margin: clamp(3rem, 6vw, 4.5rem) 0 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) { .team-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1024px) { .team-grid { grid-template-columns: repeat(3, 1fr); } }
  .team-grid > li { display: flex; }
  .team-tile {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    min-height: 19rem;
    padding: 1.75rem;
    background: var(--color-ink);
    overflow: hidden;
    isolation: isolate;
    transition: background-color var(--dur) ease;
  }
  .team-tile::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 3px;
    background: var(--color-gold);
